{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "clickup": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@taazkareem/clickup-mcp-server@0.14.5"
      ],
      "environment": {
        "CLICKUP_API_KEY": "{env:CLICKUP_API_KEY}",
        "CLICKUP_TEAM_ID": "{env:CLICKUP_TEAM_ID}"
      }
    }
  },
  "experimental": {
    "subagent_depth": 2
  }
}
