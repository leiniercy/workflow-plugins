# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/

# Node (por si se añaden scripts con dependencias)
node_modules/

# Artefactos locales de prueba
graphify-out/
*.log

# Resultados del eval de activación (se regeneran en cada ejecución)
adapters/claude/evals/results/

# Credenciales — NUNCA versionar
.mcp.json
.env
.env.*

# Excepción: el .mcp.json EMPAQUETADO del plugin Claude usa solo placeholders de
# variables de entorno (sin secretos) y DEBE versionarse para que Claude Code lo
# auto-registre al instalar el plugin. Lo genera scripts/sync.mjs.
!adapters/claude/.mcp.json
